<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biometric hardware authentication (Android 8.0 - 16) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Explicit, user-initiated foreground camera capture & privacy test only -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 13+ runtime notification permission for opt-in foreground monitor & security alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional special permissions explicitly granted by the user in System Settings -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Optional foreground service for UsageStats polling when Accessibility is disabled (Android 14+ specialUse) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility (Android 11+): Discover user-launchable installed apps cleanly without QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SecureLockApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureLockAI"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SecureLockAI"
            android:windowSoftInputMode="adjustResize" />

        <!-- Switchable launcher aliases for Custom App Icons (enabled/disabled via PackageManager) -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityVault"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_icon_vault"
            android:label="@string/icon_label_vault"
            android:roundIcon="@drawable/ic_icon_vault"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMinimal"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_icon_minimal"
            android:label="@string/icon_label_minimal"
            android:roundIcon="@drawable/ic_icon_minimal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityUtility"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_icon_utility"
            android:label="@string/icon_label_utility"
            android:roundIcon="@drawable/ic_icon_utility"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Protected app gate & customizable decoy screen -->
        <activity
            android:name=".LockOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.SecureLockAI" />

        <!-- Optional Foreground Monitor Service (requires user opt-in + Usage Access) -->
        <service
            android:name=".service.AppLockMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled app lock foreground detection via UsageStatsManager" />
        </service>

        <!-- Optional Accessibility Service for immediate app launch detection -->
        <service
            android:name=".service.AppLockAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Optional Notification Listener for local-only notification privacy masking -->
        <service
            android:name=".service.LockNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Private FileProvider strictly scoped to app-private intruder captures -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
